POSTGRES_DB=cvertidor_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
DB_URL=postgresql://admin:password@localhost:5432/cvertidor_db

# Proveedor principal de modelos (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Opcional: solo si algún rol usa modelos de Google (google:<modelo>)
API_KEY=api_key

# Carpeta donde se guardan los CV generados
OUTPUT_DIR=output
