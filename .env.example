# ---------------------------------------------------------------------------
# Credenciales de CVertidor. Copia este archivo a `.env` y rellena los valores.
# NUNCA commitees `.env` (ya está en .gitignore).
# ---------------------------------------------------------------------------

# Google AI Studio (Gemini): parsing, generación estructurada y embeddings
GOOGLE_API_KEY=

# Supabase / PostgreSQL: cadena de conexión DSN
# Ejemplo: postgresql://postgres.{ref}:{DB_PASSWORD}@aws-{region}.pooler.supabase.com:5432
SUPABASE_URL=

# Clave de REST de Supabase (opcional; si usas la API PostgREST)
SUPABASE_KEY=

# OpenRouter: API key y modelo evaluador (100% gratis, sin costo de tokens)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EVAL_MODEL=meta-llama/llama-3-8b-instruct:free

# Modelos y parámetros de Gemini (ajusta según disponibilidad de tu plan)
GEMINI_PARSE_MODEL=gemini-3.6-flash
GEMINI_GEN_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=models/gemini-embedding-2
EMBEDDING_DIM=768

# Parámetros de recuperación MMR y ciclo de corrección
RETRIEVER_K=6
RETRIEVER_FETCH_K=20
RETRIEVER_LAMBDA=0.7
MAX_ITERATIONS=3
