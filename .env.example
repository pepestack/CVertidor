POSTGRES_DB=cvertidor_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
DB_URL=postgresql://admin:password@localhost:5432/cvertidor_db

# Proveedor principal: Gemini (https://aistudio.google.com/apikey).
# También se acepta el nombre API_KEY del .env original del notebook
GOOGLE_API_KEY=api_key

# Opcional: solo si algún rol usa modelos de OpenRouter (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=sk-or-...

# Carpeta donde se guardan los CV generados
OUTPUT_DIR=output

# --- Modelos por rol (opcional: sin definirlos se usan los valores por defecto) ---
# Formato "<proveedor>:<modelo>" con proveedor google u openrouter; sin prefijo = openrouter.
# Los fallbacks van separados por comas y se usan si el principal falla (ej. 429).
# Pruebe cualquier cambio con: uv run cvertidor check-models
#
# Por defecto (Gemini, igual que el notebook):
# PARSER_MODEL=google:gemini-3.1-flash-lite
# PARSER_MODEL_FALLBACKS=google:gemini-3-flash-preview   (igual en los demás roles de chat)
# JOB_MODEL=            (vacío = mismos modelos que el parser)
# GENERATOR_MODEL=google:gemini-3.1-flash-lite
# REFINER_MODEL=google:gemini-3.1-flash-lite
# ESCALATION_MODEL=google:gemini-3.1-flash-lite
# EMBEDDING_MODEL=google:models/gemini-embedding-2
#
# Perfil OpenRouter (modelos gratuitos; requiere OPENROUTER_API_KEY). Descomente para usarlo:
# PARSER_MODEL=openrouter:nvidia/nemotron-3.5-super-vl:free
# PARSER_MODEL_FALLBACKS=openrouter:google/gemma-4-31b-it:free,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
# GENERATOR_MODEL=openrouter:nvidia/nemotron-3.5-super-vl:free
# GENERATOR_MODEL_FALLBACKS=openrouter:google/gemma-4-31b-it:free,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
# REFINER_MODEL=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
# REFINER_MODEL_FALLBACKS=openrouter:google/gemma-4-31b-it:free
# ESCALATION_MODEL=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
# EMBEDDING_MODEL=openrouter:nvidia/nemotron-3.5-embed-1b:free
#
# Forzar el método de salida estructurada de un rol (json_schema | function_calling | json_mode):
# GENERATOR_STRUCTURED_METHOD=
